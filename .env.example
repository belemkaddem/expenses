# Les deux personnes : Nom|Téléphone|Mot de passe web, séparées par ;
USERS=Yassine|0612345678|motdepasse1;Sara|0698765432|motdepasse2

# Base de données (laisser vide en local => fichier SQLite depenses.db)
DATABASE_URL=

# Jeton secret ajouté à l'URL du webhook (?token=...)
WEBHOOK_TOKEN=un-long-jeton-aleatoire
SECRET_KEY=une-autre-cle-aleatoire

# SMS Gateway for Android (onglet "Cloud server" de l'app) — pour les réponses SMS
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USER=
SMSGATE_PASSWORD=
SMS_REPLY=1

CURRENCY=DH
TZ=Africa/Casablanca
